pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npx install playwright'
            }
        }

        stage('Run Playwright Tests') {
    steps {
        bat 'npx playwright test || exit /b 0'
    }
}
    }

    post {
        always {
            archiveArtifacts artifacts: 'playwright-report/**', allowEmptyArchive: true
        }
    }
}